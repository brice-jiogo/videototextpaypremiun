rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} { 
      allow read, write: if false; 
    }

    // Primitive definition
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }
    function incoming() { 
      return request.resource.data; 
    }
    function existing() { 
      return resource.data; 
    }
    function isSignedIn() { 
      return request.auth != null; 
    }

    // User Profile Blueprint. Payment fields are written only by the trusted server/Admin SDK.
    function isValidUser(data) {
      return data.keys().hasAll(['email', 'uid', 'premiumStatus', 'createdAt'])
        && data.email is string
        && data.email.size() <= 200
        && data.uid is string
        && data.premiumStatus in ['FREE', 'PREMIUM', 'PREMIUM_TRIAL', 'CANCELING', 'PAST_DUE']
        && (!('stripeCustomerId' in data) || data.stripeCustomerId == null || (data.stripeCustomerId is string && data.stripeCustomerId.size() <= 200))
        && (!('stripeSubscriptionId' in data) || data.stripeSubscriptionId == null || (data.stripeSubscriptionId is string && data.stripeSubscriptionId.size() <= 200));
    }

    function protectedBillingFields() {
      return [
        'premiumStatus',
        'premiumActivationMessage',
        'premiumStartDate',
        'premiumEndDate',
        'nextRenewalDate',
        'subscriptionType',
        'subscriptionCancelAtPeriodEnd',
        'subscriptionCanceledAt',
        'billingInterval',
        'isLifetime',
        'stripeCustomerId',
        'stripeSubscriptionId',
        'stripeLastCheckoutSessionId',
        'lastPaymentDate',
        'lastPaymentAmount',
        'lastPaymentCurrency',
        'lastReceiptUrl',
        'lastInvoiceUrl'
      ];
    }

    // Users Collection
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;

      // We allow a user to create their own profile, MUST be FREE tier initially
      allow create: if isSignedIn() && isValidId(userId) && request.auth.uid == userId
        && isValidUser(incoming())
        && incoming().premiumStatus == 'FREE'
        && (!('stripeCustomerId' in incoming()) || incoming().stripeCustomerId == null)
        && (!('stripeSubscriptionId' in incoming()) || incoming().stripeSubscriptionId == null);

      // Users may edit only non-billing profile data. Billing status is server-owned.
      allow update: if isSignedIn() && isValidId(userId) && request.auth.uid == userId
        && !incoming().diff(existing()).affectedKeys().hasAny(protectedBillingFields());

      allow delete: if false;

      match /payments/{paymentId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow write: if false;
      }
    }
  }
}
