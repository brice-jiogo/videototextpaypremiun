# ===========================
# Frontend (Vite) - these are exposed to client code (public config)
# Set these in Vercel under Environment Variables for the frontend deployment
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# If your backend API is hosted separately, set this to its base URL (e.g. https://api.example.com)
# Leave empty if frontend and backend are served from the same origin
VITE_API_BASE_URL=

# Optional frontend-only keys
VITE_GOOGLE_TRANSLATE_KEY=

# ===========================
# Server / Backend (never commit real secrets)
# These belong on the server host or in Vercel/hosting project env (do NOT expose to client)
# ===========================
# App URL used by backend to build Stripe success/cancel URLs
APP_URL=https://videototextservices.vercel.app

# Stripe (server only) - secret key
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional amounts (in cents) - server uses defaults if not provided
STRIPE_MONTHLY_AMOUNT=999
STRIPE_YEARLY_AMOUNT=6999
STRIPE_LIFETIME_AMOUNT=12999

# Firebase Admin service account for backend (required in production for Premium activation):
# Option 1: base64-encoded JSON service account (recommended for platforms like Vercel)
FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=
# Option 2: path to service account JSON file on server (if applicable)
FIREBASE_SERVICE_ACCOUNT_PATH=

# Fallback web API key used by server token verification (if needed)
FIREBASE_WEB_API_KEY=

# Firestore DB id (usually "(default)")
FIRESTORE_DATABASE_ID=(default)

# SMTP for sending receipts/emails (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false

# NODE / server
NODE_ENV=production
PORT=3000
