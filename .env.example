# ===========================
# Firebase Configuration
# ===========================
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_WEB_API_KEY=your-firebase-web-api-key
FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=your-base64-encoded-service-account
FIREBASE_SERVICE_ACCOUNT_PATH=
FIRESTORE_DATABASE_ID=(default)

# ===========================
# Stripe Configuration
# ===========================
# Use TEST_MODE_SECRET for testing, PRODUCTION_SECRET for production
# Contact Stripe support to get your actual secret key
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_MONTHLY_AMOUNT=999
STRIPE_YEARLY_AMOUNT=6999
STRIPE_LIFETIME_AMOUNT=12999

# ===========================
# SMTP Configuration (Email Receipts)
# ===========================
# Leave empty to disable email receipts
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
SMTP_SECURE=false

# ===========================
# Application Configuration
# ===========================
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# ===========================
# Optional: Google Translate
# ===========================
VITE_GOOGLE_TRANSLATE_KEY=